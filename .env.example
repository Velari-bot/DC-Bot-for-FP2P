# Discord bot (Railway / local)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
PUBLIC_SERVER_ID=

SITE_URL=https://www.fortnitepathtopro.com

# Firebase Admin — base64 of service account JSON (recommended on Railway)
# Single line, no quotes. Generate: node scripts/encode-service-account.js path/to/key.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Admin slash commands (comma-separated role IDs and/or user IDs)
DISCORD_ADMIN_ROLE_IDS=
ADMIN_DISCORD_IDS=

# Optional webhooks & audit
DISCORD_PURCHASE_WEBHOOK_URL=
DISCORD_MOD_WEBHOOK_URL=
DISCORD_AUDIT_WEBHOOK_URL=
DISCORD_AUDIT_CHANNEL_ID=

# Optional timing (ms)
DISCORD_SYNC_INTERVAL_MS=1800000
DISCORD_AUDIT_INTERVAL_MS=604800000
DISCORD_SYNC_BATCH_DELAY_MS=500

# Railway sets PORT automatically
# PORT=8080

# Skip guild command register on boot if you register manually once
# DISCORD_SKIP_GUILD_COMMAND_REGISTER_ON_START=1
